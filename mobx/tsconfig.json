{
    "compilerOptions": {
        "baseUrl": ".",
        "esModuleInterop": true,
        "moduleResolution": "node",
        "target": "es2020",
        "module": "commonjs",
        "strict": true,
        "moduleDetection": "force",
        "declaration": true,
        "declarationDir": "./dist/types"
    },
    "include": [
        "./src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}